# Copy this file to `.env.local` and fill in the values. `.env.local` is git-ignored —
# never commit real keys, and never paste a key into a chat or an issue.

# --- Supabase (auth, data, storage) ------------------------------------------------
# Public by design (Row Level Security protects the data). `lib/supabase/env.ts` also
# carries working defaults, so these are optional in practice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the admin route handlers and the push test endpoint.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push ----------------------------------------------------------------------
# The VAPID PUBLIC key: 87–88 URL-safe base64 characters, starting with "B".
#
# It is public by design (the browser sends it to the push service), but it must be the
# SAME key as the send-push Edge Function's VAPID_PUBLIC_KEY secret. A different value
# makes every device subscribe against one key while sends are signed with the other, so
# the push service refuses each alert.
#
# NEXT_PUBLIC_* values are inlined at build time, so set this before building and redeploy
# after changing it. Leave it empty and the Account page reports that notifications are
# not configured on this deployment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Never put VAPID_PRIVATE_KEY here: it belongs only in the Supabase Edge Function secrets.
