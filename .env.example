# Copy this file to `.env.local` and fill in the values from
# Supabase → Project Settings → API. Never commit real secrets.

# Public (safe to expose; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push — public VAPID key. Optional: lib/push.ts already carries the project's
# public key as a fallback. The VAPID PRIVATE key belongs ONLY in the `send-push` Edge
# Function secrets — never here and never in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only
SUPABASE_URL=

# SECRET — service-role key bypasses RLS. Server-side only. Set this in your
# host (e.g. Vercel → Settings → Environment Variables) as a sensitive value.
SUPABASE_SERVICE_ROLE_KEY=
